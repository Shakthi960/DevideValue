# ============================================================
# Device Valuation Platform — Backend Environment Variables
# ============================================================
# Copy this file to `.env` and fill in your real values.
# Never commit the real `.env` file.
# Create the values below before running the app.

# --- Database (PostgreSQL) ---
# Example: postgresql://user:password@host:5432/dbname
# Supabase Postgres or any local PostgreSQL instance.
DATABASE_URL=postgresql://user:password@localhost:5432/device_valuation

# --- Supabase (auth) ---
# From Supabase dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# --- Google Gemini (photo condition analysis + RAG answers) ---
# From https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
