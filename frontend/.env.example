# --- Frontend backend URL (optional) ---
# Vite reads this at build/dev time. If unset, the app defaults to
# http://127.0.0.1:8000.
VITE_API_URL=http://127.0.0.1:8000

# --- Supabase (optional) ---
# Enables "Continue with Google" sign-in. Copy these from
# Supabase dashboard -> Project Settings -> API (URL + anon key).
# If omitted, the Google button is hidden and only email/password
# sign-in is shown.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key